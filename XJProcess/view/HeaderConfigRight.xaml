<UserControl x:Class="XJProcess.view.HeaderConfigRight"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="650">

    <UserControl.Resources>
        <Style x:Key="OverViewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#33FFFFFF" 
            BorderThickness="0,0,0,1" 
            Padding="16,12"
            Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="THÔNG TIN ĐƠN THUỐC" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="#FFFFFF" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">

                <Button x:Name="BtnStopOrder" 
                        Width="150" Height="32" 
                        Margin="0,0,8,0"
                        Background="#C62828" 
                        Foreground="#FFFFFF" 
                        BorderBrush="#FF5252"
                        Style="{StaticResource OverViewButtonStyle}" 
                        Click="BtnStopOrder_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏹" FontSize="13" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dừng Đơn" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Setting" 
                        Width="90" Height="32" 
                        Margin="0,0,8,0"
                        Background="#0284C7" 
                        Foreground="#FFFFFF" 
                        BorderBrush="#38BDF8" 
                        Style="{StaticResource OverViewButtonStyle}" 
                        Click="btn_Setting_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="13" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Setting" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_History" 
                        Width="90" Height="32" 
                        Background="#4F46E5" 
                        Foreground="#FFFFFF" 
                        BorderBrush="#818CF8" 
                        Style="{StaticResource OverViewButtonStyle}" 
                        Click="btn_History_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📜" FontSize="13" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="History" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>