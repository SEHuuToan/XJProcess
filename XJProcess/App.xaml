<Application x:Class="XJProcess.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XJProcess"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- STYLE NÚT BẤM HIỆN ĐẠI (OVERVIEW BUTTON) -->
        <Style x:Key="OverViewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="btnBorder" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="btnBorder" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="btnBorder" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho các ô nhập liệu/lọc dữ liệu -->
        <Style x:Key="HmiInputStyle" TargetType="Control">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style cho tiêu đề nhóm -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Style cho nhãn trường dữ liệu -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="200" Height="26" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thủ Công" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="#FFFFFF" 
                               x:Name="TxtFull"/>
                            <Grid Grid.Column="1" Width="46" Height="24">
                                <Border x:Name="SwitchBorder" 
                                Background="#334155" 
                                BorderBrush="#475569" 
                                BorderThickness="1" 
                                CornerRadius="12"/>
                                <Border x:Name="SwitchThumb" 
                                Width="18" Height="18" 
                                Background="#FFFFFF" 
                                CornerRadius="8" 
                                HorizontalAlignment="Left" 
                                Margin="3,0,0,0"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="Tự Động" 
                               VerticalAlignment="Center" 
                               Margin="8,0,0,0" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="#94A3B8" 
                               x:Name="TxtAuto"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="25,0,0,0"/>
                                <Setter TargetName="TxtAuto" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TxtFull" Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="TxtFull" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TxtAuto" Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>