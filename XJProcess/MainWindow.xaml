<Window x:Class="XJProcess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:local="clr-namespace:XJProcess"
        mc:Ignorable="d"
        Title="XJProcess - Industrial Dashboard" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        >

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- STYLE NÚT BẤM HIỆN ĐẠI (OVERVIEW BUTTON) -->
        <Style x:Key="OverViewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image Source="/Images/background.png" 
                   Stretch="UniformToFill" 
                   Grid.RowSpan="2" 
                   Grid.ColumnSpan="2"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="90" KernelType="Gaussian"/>
                </Image.Effect>
            </Image>

            <!-- ================= KHU 1: TOP-LEFT ================= -->
            <Border Grid.Row="0" Grid.Column="0" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="0,0,1,1" 
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTankCode" Text="7#" FontSize="60" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Image Grid.Column="1" 
                               Source="/Images/background.png" 
                               Height="105" 
                               Width="255" 
                               Stretch="Uniform" 
                               VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#33FFFFFF" Margin="0,0,0,-5"/>

                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="MSNV:  " FontSize="13" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="TxtEmpCode" Text="2000000" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Họ và Tên:  " FontSize="13" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="TxtEmpName" Text="Nguyễn Văn A" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Thời gian:  " FontSize="13" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="TxtCurrentTime" Text="2026-08-12 13:30:00" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="Nhiệt độ bồn quay:  " FontSize="14" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTankTemp" Text="50°C" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= KHU 2: TOP-RIGHT ================= -->
            <Border Grid.Row="0" Grid.Column="1" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="0,0,0,1" 
                    Padding="15,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        

                        <TextBlock Grid.Column="0" 
                                   Text="THÔNG TIN ĐƠN" 
                                   FontSize="24" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FFFFFF" 
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"/>
                        <Grid Grid.Column="1"/>

                        <StackPanel Grid.Column="2" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center">
                            <Button x:Name="btn_Setting" 
                                    Width="105" Height="36" 
                                    Margin="0,0,10,0"
                                    Background="#0284C7" 
                                    Foreground="#FFFFFF" 
                                    BorderBrush="#38BDF8" 
                                    Style="{StaticResource OverViewButtonStyle}" 
                                    Click="btn_Setting_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⚙" FontSize="15" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Setting" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btn_History" 
                                    Width="105" Height="36" 
                                    Background="#4F46E5" 
                                    Foreground="#FFFFFF" 
                                    BorderBrush="#818CF8" 
                                    Style="{StaticResource OverViewButtonStyle}" 
                                    Click="btn_History_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📜" FontSize="14" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="History" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Chi tiết đơn hàng -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" x:Name="OrderHeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="5,0,15,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Line1Col0}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                            <TextBlock Text="{Binding Line2Col0}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                            <TextBlock Text="{Binding Line3Col0}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                            <TextBlock Text="{Binding Line4Col0}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,15,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Line1Col1}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                            <TextBlock Text="{Binding Line2Col1}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                            <TextBlock Text="{Binding Line3Col1}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                            <TextBlock Text="{Binding Line4Col1}" Foreground="#FFFFFF" FontSize="14" Margin="0,3"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="5,0,5,0" HorizontalAlignment="Right">
                            <TextBlock Foreground="#FFFFFF" FontSize="14" Margin="0,3">
                                <Run Text="技术员: "/>
                                <Run Text="{Binding TechnicianName}" FontWeight="Bold" Foreground="#FFFFFF"/>   
                            </TextBlock>
                            <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" Margin="0,3">
                                <Run Text="鼓号: "/>
                                <Run Text="{Binding DrumNo}"/>  
                            </TextBlock>
                            <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" Margin="0,3">
                                <Run Text="投鼓时间: "/>
                                <Run Text="{Binding StartTime}"/>   
                            </TextBlock>
                            <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" Margin="0,3">
                                <Run Text="出鼓时间: "/>
                                <Run Text="{Binding EndTime}"/> 
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="5,0,5,0">
                            <Button x:Name="BtnStopOrder" 
                                Width="95" Height="90"
                                Margin="4"
                                Background="#C62828" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#FF5252"
                                Style="{StaticResource OverViewButtonStyle}" 
                                HorizontalAlignment="Right"
                                Click="BtnStopOrder_Click"> 
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⏹" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Dừng Đơn" FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= KHU 3: BOTTOM-LEFT ================= -->
            <Border Grid.Row="1" Grid.Column="0" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="0,0,1,0" 
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ĐIỀU KHIỂN HỆ THỐNG" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                        <helix:HelixViewport3D x:Name="TankViewport"
                           Grid.Column="0"
                           ShowFrameRate="False" 
                           ShowCoordinateSystem="False" 
                           ShowViewCube="False"
                           Background="Transparent"
                           IsRotationEnabled="False" 
                           IsViewCubeEdgeClicksEnabled="False"
                           ZoomExtentsWhenLoaded="True">
                            <helix:DefaultLights />
                        </helix:HelixViewport3D>
                        <Grid Grid.Column="1" Margin="0,10,15,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="135" Height="135">
                                <Ellipse Stroke="#FFFFFF" StrokeThickness="12" Margin="4"/>
                                <Path x:Name="ProgressArc" Stroke="#05a630" StrokeThickness="12.5"  Margin="4"/>
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtCountdownTime" Text="00:00" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="ĐIỀU KHIỂN HỆ THỐNG" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   Foreground="#94A3B8" 
                                   Margin="0,5,0,10"
                                   HorizontalAlignment="Center"/>
                        <Grid Grid.Row="1" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,12">
                                <ToggleButton x:Name="TglMode" 
                                  Style="{StaticResource ModernToggleSwitch}" 
                                  Checked="TglMode_Checked" 
                                  Unchecked="TglMode_Unchecked"/>   
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thời gian vận hành:" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtRunTimeInput" Grid.Column="1" Height="32" Background="#FFFFFF" Foreground="#000000" BorderBrush="#33FFFFFF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"
                                     InputScope="Number"
                                     PreviewTextInput="NumberOnly_PreviewTextInput"
                                     DataObject.Pasting="TextBox_Pasting"/>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Thời gian đảo chiều:" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtReverseTimeInput" Grid.Column="1" Height="32" Background="#FFFFFF" Foreground="#000000" BorderBrush="#33FFFFFF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"
                                     InputScope="Number"
                                     PreviewTextInput="NumberOnly_PreviewTextInput"
                                     DataObject.Pasting="TextBox_Pasting"/> 
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock Text="Chế độ:                            " FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#00C853" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtButtonStatus" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Border>

                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="10">
                                <TextBlock Text="Mã đơn quét được:" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="txtScannedResult" 
                                       Text="Chưa có dữ liệu..." 
                                       FontSize="16" 
                                       Foreground="Blue" 
                                       Margin="0,5,0,0" />  
                            </StackPanel>
                        </Grid>
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnStart" 
                                Width="95" Height="90"
                                Margin="4"
                                Background="#00C853" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#69F0AE"
                                Style="{StaticResource OverViewButtonStyle}"
                                Click="BtnStart_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="CHẠY" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnStop" 
                                Width="95" Height="90"
                                Margin="4"
                                Background="#C62828" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#FF5252"
                                Style="{StaticResource OverViewButtonStyle}"
                                Click="BtnStop_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⏹" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="DỪNG" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnRotateUp" 
                                Width="95" Height="90"
                                Margin="4"
                                Background="#0284C7" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#38BDF8"
                                Style="{StaticResource OverViewButtonStyle}"
                                Click="BtnRotateUp_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🔼" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="XOAY" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="BtnRotateDown" 
                                Width="95" Height="90"
                                Margin="4"
                                Background="#4F46E5" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#818CF8"
                                Style="{StaticResource OverViewButtonStyle}"
                                Click="BtnRotateDown_Click">    
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🔽" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="XOAY" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= KHU 4: BOTTOM-RIGHT (DATAGRID MAIN) ================= -->
            <Border Grid.Row="1" Grid.Column="1" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtNoOrderMessage" 
                           Grid.Row="1" 
                           Text="Chưa quét đơn bồn quay" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="#888888" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Visibility="Visible"
                     />
                    <DataGrid Grid.Row="1" 
                              x:Name="MainDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="Transparent" 
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#22FFFFFF" 
                              VerticalGridLinesBrush="#22FFFFFF"
                              BorderBrush="#0284C7"
                              BorderThickness="1"
                              RowHeight="50"
                              ColumnHeaderHeight="45"
                              FontSize="16"
                              Foreground="#FFFFFF"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#220284C7"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#440284C7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NO" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StepNo}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#FFFFFF"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="CHEM" Binding="{Binding ChemName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="KG" Binding="{Binding Kg}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="°C" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Temp}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   Foreground="#FFFFFF" 
                                                   FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="h" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding DurationDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="CHECK" Binding="{Binding CheckInfo}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="myBadge" Background="#00C853" CornerRadius="6" Padding="8, 4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Status}"
                                               Foreground="#FFFFFF"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/> 
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Đã hoàn thành">
                                                <Setter TargetName="myBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionButtonText}" 
                                                Width="100" Height="40" 
                                                FontSize="16" FontWeight="Bold"
                                                Background="{Binding ActionButtonBackground}" 
                                                Foreground="#FFFFFF"
                                                Style="{StaticResource OverViewButtonStyle}"
                                                Click="BtnAction_Click"
                                                IsEnabled="{Binding IsButtonEnabled}"
                                                Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="OverlayBlurGrid" Visibility="Collapsed">
            <Border Background="#A0FFFFFF" />
        </Grid>
    </Grid>
</Window>