<UserControl x:Class="XJProcess.view.DrumConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="648" d:DesignWidth="360">

    <UserControl.Resources>
        <Style x:Key="OverViewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Khối 3D & Progress Bar đếm thời gian -->
                <RowDefinition Height="1*"/>
                <!-- Row 1: Khối phím bấm & nhập liệu -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= KHỐI 3D & PROGRESS BAR (1 Cột, 2 Hàng) ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <!-- Mô hình 3D -->
                    <RowDefinition Height="*"/>
                    <!-- Progress timer bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mô hình 3D bồn quay -->
                <helix:HelixViewport3D x:Name="TankViewport"
                                       Grid.Row="0"
                                       Margin="0,0,0,0"
                                       ShowFrameRate="False" 
                                       ShowCoordinateSystem="False" 
                                       ShowViewCube="False"
                                       Background="Transparent"
                                       IsRotationEnabled="False" 
                                       IsViewCubeEdgeClicksEnabled="False"
                                       ZoomExtentsWhenLoaded="True">
                    <helix:DefaultLights />
                </helix:HelixViewport3D>

                <Grid Grid.Row="1" Margin="10,5,10,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="Thời gian: " FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCountdownTime" Text="00:00" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar x:Name="ProgressArc" 
                         Grid.Row="1" 
                         Height="14" 
                         Minimum="0" 
                         Maximum="100" 
                         Value="0"
                         BorderBrush="Transparent">     
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="White">
                                    <Grid x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="#05a630" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </Grid>
            </Grid>

            <!-- ================= KHỐI ĐIỀU KHIỂN & NÚT BẤM ================= -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
               Text="ĐIỀU KHIỂN HỆ THỐNG" 
               FontSize="13" 
               FontWeight="Bold" 
               Foreground="#94A3B8" 
               Margin="0,5,0,10"
               HorizontalAlignment="Center"/>

                <Grid Grid.Row="1" Margin="5,0,5,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Chế độ: " FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="#00C853" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtButtonStatus" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ToggleButton x:Name="TglMode"
                              Style="{StaticResource ModernToggleSwitch}" 
                              Checked="TglMode_Checked" 
                              Unchecked="TglMode_Unchecked"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Vận hành (phút):" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtRunTimeInput" Grid.Row="1" Height="25" Background="#FFFFFF" Foreground="#000000" BorderBrush="#33FFFFFF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"
                             InputScope="Number"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             DataObject.Pasting="TextBox_Pasting"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Đảo chiều (phút):" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtReverseTimeInput" Grid.Row="1" Height="25" Background="#FFFFFF" Foreground="#000000" BorderBrush="#33FFFFFF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"
                             InputScope="Number"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             DataObject.Pasting="TextBox_Pasting"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Các nút CHẠY / DỪNG / XOAY -->
                <UniformGrid Grid.Row="2" Columns="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,5,0,0">
                    <Button x:Name="BtnStart" 
                    Height="80"
                    Margin="3"
                    Background="#00C853" 
                    Foreground="#FFFFFF" 
                    BorderBrush="#69F0AE"
                    Style="{StaticResource OverViewButtonStyle}"
                    Click="BtnStart_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="CHẠY" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStop" 
                    Height="80"
                    Margin="3"
                    Background="#C62828" 
                    Foreground="#FFFFFF" 
                    BorderBrush="#FF5252"
                    Style="{StaticResource OverViewButtonStyle}"
                    Click="BtnStop_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏹" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="DỪNG" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotateUp" 
                    Height="80"
                    Margin="3"
                    Background="#0284C7" 
                    Foreground="#FFFFFF" 
                    BorderBrush="#38BDF8"
                    Style="{StaticResource OverViewButtonStyle}"
                    Click="BtnRotateUp_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔼" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="XOAY" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotateDown" 
                    Height="80"
                    Margin="3"
                    Background="#4F46E5" 
                    Foreground="#FFFFFF" 
                    BorderBrush="#818CF8"
                    Style="{StaticResource OverViewButtonStyle}"
                    Click="BtnRotateDown_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔽" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="XOAY" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>