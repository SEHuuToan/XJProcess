<Window x:Class="XJProcess.view.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CustomMessageBox" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Chỉ giữ lại duy nhất khung Border trắng phẳng, không bóng xám, không hiệu ứng -->
    <Border Background="#FFFFFF" 
            CornerRadius="12" 
            BorderBrush="#CBD5E1" 
            BorderThickness="1"
            Width="440" 
            Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ICON & TIÊU ĐỀ -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="18" Background="#FEF3C7" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtIconSymbol" Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,0,0,5"/>
                </Border>
                <TextBlock x:Name="TxtTitle" Text="Thông báo" Foreground="#0F172A" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- NỘI DUNG THÔNG BÁO -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1" 
                       Text="Nội dung thông báo ở đây..." 
                       Foreground="#475569" 
                       FontSize="15" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center"
                       Margin="0,10,0,24"/>

            <!-- NÚT BẤM HÀNH ĐỘNG -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Hủy" Width="90" Height="38" Margin="0,0,10,0"
                        Background="#E2E8F0" Foreground="#334155" FontSize="14" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnOk" Content="Xác nhận" Width="100" Height="38"
                        Background="#0284C7" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnOk_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>