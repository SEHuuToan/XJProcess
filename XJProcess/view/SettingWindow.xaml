<Window x:Class="XJProcess.view.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XJProcess.view"
        Title="Cấu Hình Hệ Thống" 
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="HmiInputStyle" TargetType="Control">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#55E2E8F0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#0284C7" BorderThickness="2" 
                Width="750" Height="650" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="22" Background="#0284C7" Margin="0,0,10,0"/>
                        <TextBlock Text="CẤU HÌNH HỆ THỐNG" Foreground="#0F172A" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>

                    <Button Content="✕" Width="36" Height="36" HorizontalAlignment="Right"
                            Background="#E2E8F0" Foreground="#475569" FontSize="16"
                            Style="{StaticResource OverViewButtonStyle}" Click="BtnCancel_Click"/>
                </Grid>

                <Grid x:Name="LoginGrid" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="30" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                            <TextBlock Text="XÁC NHẬN MẬT KHẨU" 
                                       Foreground="#0F172A" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Nhập mật khẩu quản trị để tiếp tục" 
                                       Foreground="#64748B" FontSize="13" 
                                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

                            <TextBlock Text="Mật khẩu cài đặt:" Foreground="#334155" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="TxtPassword" Height="44" 
                                         Style="{StaticResource HmiInputStyle}"
                                         KeyDown="TxtPassword_KeyDown"/>
                            <TextBlock x:Name="TxtErrorMessage" 
                                       Text="⚠️ Mật khẩu không đúng!" 
                                       Foreground="#DC2626" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Height="24"
                                       Margin="0,8,0,0" 
                                       Visibility="Hidden" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Hủy" Width="100" Height="40" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold"
                                Background="#C62828" Foreground="#FFFFFF"
                                Style="{StaticResource OverViewButtonStyle}" Click="BtnCancel_Click"/>
                        <Button Content="Xác nhận" Width="120" Height="40"  FontSize="14" FontWeight="SemiBold"
                                Background="#FF4169E1" Foreground="#FFFFFF" 
                                Style="{StaticResource OverViewButtonStyle}" Click="BtnLogin_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>