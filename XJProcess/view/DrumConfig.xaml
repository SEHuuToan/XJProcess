<UserControl x:Class="XJProcess.view.DrumConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="480">

    <UserControl.Resources>
        <Style x:Key="OverViewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0" Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Khối Viewport 3D & Countdown -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ĐIỀU KHIỂN HỆ THỐNG" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <helix:HelixViewport3D x:Name="TankViewport"
                                       Grid.Column="0"
                                       ShowFrameRate="False" 
                                       ShowCoordinateSystem="False" 
                                       ShowViewCube="False"
                                       Background="Transparent"
                                       IsRotationEnabled="False" 
                                       IsViewCubeEdgeClicksEnabled="False"
                                       ZoomExtentsWhenLoaded="True">
                    <helix:DefaultLights />
                </helix:HelixViewport3D>

                <Grid Grid.Column="1" Margin="0,10,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="135" Height="135">
                        <Ellipse Stroke="#FFFFFF" StrokeThickness="12" Margin="4"/>
                        <Path x:Name="ProgressArc" Stroke="#05a630" StrokeThickness="12.5" Margin="4"/>
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtCountdownTime" Text="00:00" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Khối Điều khiển & Nút bấm -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="ĐIỀU KHIỂN HỆ THỐNG" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="#94A3B8" 
                           Margin="0,5,0,10"
                           HorizontalAlignment="Center"/>

                <Grid Grid.Row="1" Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toggle Mode Switch -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,12">
                        <ToggleButton x:Name="TglMode" 
                                      Style="{StaticResource ModernToggleSwitch}" 
                                      Checked="TglMode_Checked" 
                                      Unchecked="TglMode_Unchecked"/>
                    </StackPanel>

                    <!-- Hàng 1: Thời gian vận hành -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thời gian vận hành:" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtRunTimeInput" Grid.Column="1" Height="32" Background="#FFFFFF" Foreground="#000000" BorderBrush="#33FFFFFF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"
                                 InputScope="Number"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"
                                 DataObject.Pasting="TextBox_Pasting"/>
                    </Grid>

                    <!-- Hàng 2: Thời gian đảo chiều -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thời gian đảo chiều:" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtReverseTimeInput" Grid.Column="1" Height="32" Background="#FFFFFF" Foreground="#000000" BorderBrush="#33FFFFFF" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold"
                                 InputScope="Number"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"
                                 DataObject.Pasting="TextBox_Pasting"/>
                    </Grid>

                    <!-- Hàng 3: Trạng thái bồn quay -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="Chế độ:                            " FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#00C853" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtButtonStatus" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Các nút CHẠY / DỪNG / XOAY -->
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" 
                            Width="95" Height="90"
                            Margin="4"
                            Background="#00C853" 
                            Foreground="#FFFFFF" 
                            BorderBrush="#69F0AE"
                            Style="{StaticResource OverViewButtonStyle}"
                            Click="BtnStart_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="CHẠY" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStop" 
                            Width="95" Height="90"
                            Margin="4"
                            Background="#C62828" 
                            Foreground="#FFFFFF" 
                            BorderBrush="#FF5252"
                            Style="{StaticResource OverViewButtonStyle}"
                            Click="BtnStop_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏹" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="DỪNG" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotateUp" 
                            Width="95" Height="90"
                            Margin="4"
                            Background="#0284C7" 
                            Foreground="#FFFFFF" 
                            BorderBrush="#38BDF8"
                            Style="{StaticResource OverViewButtonStyle}"
                            Click="BtnRotateUp_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔼" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="XOAY" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotateDown" 
                            Width="95" Height="90"
                            Margin="4"
                            Background="#4F46E5" 
                            Foreground="#FFFFFF" 
                            BorderBrush="#818CF8"
                            Style="{StaticResource OverViewButtonStyle}"
                            Click="BtnRotateDown_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔽" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="XOAY" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>