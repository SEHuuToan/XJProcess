<UserControl x:Class="XJProcess.view.HeaderConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="1024">

    <UserControl.Resources>
        <!-- STYLE NÚT BẤM OVERVIEW BUTTON -->
        <Style x:Key="OverViewButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#33FFFFFF" 
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Khớp chuẩn 480px với Column 0 trong MainWindow.xaml -->
                <ColumnDefinition Width="480"/>
                <!-- Cột còn lại chiếm 544px (1024 - 480) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= KHU VỰC BÊN TRÁI (TOP-LEFT INFO: 480x200) ================= -->
            <Border Grid.Column="0" 
                    BorderBrush="#33FFFFFF" 
                    BorderThickness="0,0,1,0" 
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hàng 0: Mã bồn & Logo/Ảnh -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTankCode" Text="7#" FontSize="52" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Image Grid.Column="1" 
                               Source="/Images/background.png" 
                               Height="85" 
                               Width="220" 
                               Stretch="Uniform" 
                               VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#33FFFFFF" Margin="0,0,0,-3"/>

                    <!-- Hàng 1: Thông tin nhân viên & Nhiệt độ -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="MSNV:  " FontSize="12" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="TxtEmpCode" Text="2000000" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Họ và Tên:  " FontSize="12" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="TxtEmpName" Text="Nguyễn Văn A" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="Thời gian:  " FontSize="12" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="TxtCurrentTime" Text="2026-08-12 13:30:00" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="Nhiệt độ bồn quay:  " FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTankTemp" Text="50°C" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= KHU VỰC BÊN PHẢI (THÔNG TIN ĐƠN & ACTIONS: 544x200) ================= -->
            <Grid Grid.Column="1" Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Header & Action Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="THÔNG TIN ĐƠN" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="#FFFFFF" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center">
                        <Button x:Name="btn_Setting" 
                                Width="90" Height="32" 
                                Margin="0,0,8,0"
                                Background="#0284C7" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#38BDF8" 
                                Style="{StaticResource OverViewButtonStyle}" 
                                Click="btn_Setting_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="13" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Setting" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btn_History" 
                                Width="90" Height="32" 
                                Background="#4F46E5" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#818CF8" 
                                Style="{StaticResource OverViewButtonStyle}" 
                                Click="btn_History_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📜" FontSize="13" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="History" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Chi tiết đơn hàng (Phân bổ vừa trong 544px) -->
                <Grid Grid.Row="1" VerticalAlignment="Center" x:Name="OrderHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột 1 chi tiết -->
                    <StackPanel Grid.Column="0" Margin="2,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Line1Col0}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="{Binding Line2Col0}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="{Binding Line3Col0}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="{Binding Line4Col0}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                    </StackPanel>

                    <!-- Cột 2 chi tiết -->
                    <StackPanel Grid.Column="1" Margin="2,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Line1Col1}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="{Binding Line2Col1}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="{Binding Line3Col1}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                        <TextBlock Text="{Binding Line4Col1}" Foreground="#FFFFFF" FontSize="11" Margin="0,2"/>
                    </StackPanel>

                    <!-- Cột 3 chi tiết -->
                    <StackPanel Grid.Column="2" Margin="2,0,5,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#FFFFFF" FontSize="11" Margin="0,2">
                            <Run Text="技术员: "/>
                            <Run Text="{Binding TechnicianName}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Margin="0,2">
                            <Run Text="鼓号: "/>
                            <Run Text="{Binding DrumNo}"/>
                        </TextBlock>
                        <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Margin="0,2">
                            <Run Text="投鼓时间: "/>
                            <Run Text="{Binding StartTime}"/>
                        </TextBlock>
                        <TextBlock Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Margin="0,2">
                            <Run Text="出鼓时间: "/>
                            <Run Text="{Binding EndTime}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Cột 4: Nút Dừng Đơn -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="5,0,0,0">
                        <Button x:Name="BtnStopOrder" 
                                Width="85" Height="78"
                                Background="#C62828" 
                                Foreground="#FFFFFF" 
                                BorderBrush="#FF5252"
                                Style="{StaticResource OverViewButtonStyle}" 
                                HorizontalAlignment="Right"
                                Click="BtnStopOrder_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Dừng Đơn" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>